# =====================
# src/test/.gitignore
# Applies to everything under src/test/
# =====================

# Maven test build output (if tests are ever built in-place)
target/
build/

# Compiled Java classes
*.class

# Test logs & runtime artifacts
*.log

# IDE / editor files
.idea/
*.iml
*.iws
.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.apt_generated

# Spring tooling
.springBeans
.sts4-cache
.remote-signature

# --- Keep test sources tracked -------------------------
# The java/ tree contains the actual test code and MUST be
# version-controlled, so nothing above may exclude it.
!java/